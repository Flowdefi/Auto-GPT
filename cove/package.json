{
  "name": "cove",
  "version": "1.0.0",
  "private": true,
  "description": "Cove — US consumer collections floor for unlicensed-state inventory. Clock-in, dialer, authenticated voice/SMS/email agents, payments, skip trace, debtor CRM.",
  "scripts": {
    "dev": "next dev --port 3001 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 3001 --hostname 0.0.0.0",
    "lint": "next lint",
    "cf:build": "OPENNEXT=1 opennextjs-cloudflare build",
    "cf:deploy": "OPENNEXT=1 opennextjs-cloudflare build && wrangler deploy --temporary"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "wrangler": "^4.135.0"
  }
}
