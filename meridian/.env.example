RESEND_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_TRITON=portfolios@agentmail.to
AGENTMAIL_INBOX_AETHER=desk@agentmail.to
MERIDIAN_PUBLIC_URL=http://localhost:3000
# Admin desk origin. Set both URLs in production so /w stays on crm and /agency stays on collect.
MERIDIAN_ADMIN_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Owner seat. Leave the password empty in git. The host injects MERIDIAN_OWNER_PASSWORD.
MERIDIAN_OWNER_EMAIL=portfolios@debtmarket.net
MERIDIAN_OWNER_PASSWORD=
# Public collections name on collect.debtmarket.net only. Leave blank to keep {{agency_name}}.
# MERIDIAN_AGENCY_NAME=DebtMarket Collections
AETHER_FROM_EMAIL=desk@aethermarkets.io

# Microsoft Graph (app-only). Grant Mail.Read, Contacts.Read, and Files.Read.All.
# Leave these empty and sync degrades to a configuration hint.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOXES=portfolios@debtmarket.net

# OpenAI-compatible models (Ollama, llama.cpp, vLLM, OpenAI, Groq, OpenRouter)
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=
MERIDIAN_MODEL=qwen2.5:14b
MERIDIAN_FAST_MODEL=llama3.2:3b
MERIDIAN_EMBED_MODEL=nomic-embed-text
OPENAI_MODEL=

# Optional live rank tracking (SerpApi / Serper / SearchApi / ValueSerp / custom)
SERP_PROVIDER_URL=
SERP_PROVIDER_KEY=
SERP_PROVIDER_NAME=

# true skips Polar and the paid-seat check. API keys can then be minted with npm run key:create.
MERIDIAN_SELF_HOSTED=false

# Used only by scripts/graph-sync.sh. Create it with npm run key:create.
MERIDIAN_API_KEY=

# Set to false in production so demo companies, contacts, and leads are not inserted.
# Docker Compose defaults this to false. `npm run dev` seeds demo data when it is unset.
MERIDIAN_SEED_DEMO=true

# Internet harden — required in production (32+ chars)
MERIDIAN_AUTH_SECRET=
MERIDIAN_SECRET_KEY=

# Collections desk. sandbox is the default and does not call providers.
# A real send also needs MERIDIAN_CHANNEL_DELIVER=live, a provider name below, and that provider's keys.
# Voice audio stays on the sandbox console.
MERIDIAN_CHANNEL_DELIVER=sandbox
MERIDIAN_SMS_PROVIDER=sandbox
MERIDIAN_EMAIL_PROVIDER=sandbox
MERIDIAN_LETTER_PROVIDER=sandbox
MERIDIAN_PAYMENTS_PROVIDER=sandbox
# 12 CFR 1006.100 is three years. Counsel should confirm this clock.
MERIDIAN_PII_RETENTION_DAYS=1095
MERIDIAN_AGENCY_FEE_PERCENT=0
# Job worker tick. Minimum effective value is 15 seconds. Default 60.
MERIDIAN_JOB_INTERVAL_SECONDS=60
# FCC Reassigned Numbers Database. sandbox returns unknown and blocks a cell call.
MERIDIAN_RND_PROVIDER=sandbox
MERIDIAN_RND_API_URL=
MERIDIAN_RND_API_KEY=
# DMDC SCRA. sandbox returns unknown and does not clear anyone. dmdc blocks while unknown.
MERIDIAN_SCRA_PROVIDER=sandbox
MERIDIAN_SCRA_API_URL=
MERIDIAN_SCRA_API_KEY=
MERIDIAN_SCRA_BLOCK_UNKNOWN=
# Metro 2 stays off until this is enabled AND owner and compliance have both approved.
MERIDIAN_METRO2_EXPORT=disabled
# Public site, portal, letters, and emails. Leave the name unset to show {{agency_name}}.
MERIDIAN_AGENCY_NAME=
MERIDIAN_AGENCY_LOGO_URL=
MERIDIAN_AGENCY_COLOR=
MERIDIAN_AGENCY_DOMAIN=
# Voice. Unset or any value other than enabled keeps the sandbox console. Live also needs MERIDIAN_CHANNEL_DELIVER=live.
MERIDIAN_VOICE_LIVE=
MERIDIAN_REALTIME_MODEL=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=
# Skip-trace. sandbox returns nothing and does not call a vendor.
MERIDIAN_SKIPTRACE_PROVIDER=sandbox
MERIDIAN_SKIPTRACE_API_URL=
MERIDIAN_SKIPTRACE_API_KEY=
# ACH. sandbox stores an authorization and does not call Stripe.
MERIDIAN_ACH_PROVIDER=sandbox
# Alert when open complaints reach this count. Metrics are behind a seat.
MERIDIAN_ALERT_OPEN_COMPLAINTS=25
# Docker demo seeds Example accounts named DEMO-OH-1, DEMO-TX-1, and DEMO-CA-1.
MERIDIAN_COLLECTIONS_DEMO=false
# Weekly digest email. Sandbox stores the digest. Live also needs MERIDIAN_CHANNEL_DELIVER=live and RESEND_API_KEY.
MERIDIAN_COMPLIANCE_DIGEST=disabled
# Optional OpenTelemetry metrics. Unset means the desk does not call a collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Bankruptcy and deceased scrubs. sandbox returns unknown and does not call a vendor. A hit holds the account.
MERIDIAN_BANKRUPTCY_PROVIDER=sandbox
MERIDIAN_BANKRUPTCY_API_URL=
MERIDIAN_BANKRUPTCY_API_KEY=
MERIDIAN_DECEASED_PROVIDER=sandbox
MERIDIAN_DECEASED_API_URL=
MERIDIAN_DECEASED_API_KEY=
# Settlement desk. Amounts at or above this many cents need two approvers. Letters wait this many days.
MERIDIAN_SETTLEMENT_DUAL_CENTS=50000
MERIDIAN_SETTLEMENT_HOLD_DAYS=3
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TELNYX_API_KEY=
TELNYX_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_WEBHOOK_SECRET=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
LOB_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
VAPI_API_KEY=
RETELL_API_KEY=
OPENAI_REALTIME_MODEL=
LOB_API_KEY=
LOB_MODE=sandbox
MERIDIAN_RND_API_URL=
STRIPE_SECRET_KEY=

# Polar (open-source merchant of record) — $275 lifetime seat
# Create a one-time product at https://polar.sh and paste its product UUID.
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production
