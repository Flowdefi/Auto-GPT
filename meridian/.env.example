RESEND_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_TRITON=portfolios@agentmail.to
AGENTMAIL_INBOX_AETHER=desk@agentmail.to
MERIDIAN_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AETHER_FROM_EMAIL=desk@aethermarkets.io

# Microsoft Graph (app-only). Grant Mail.Read and an application access policy.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOXES=portfolios@debtmarket.net

# OpenAI-compatible models (Ollama, llama.cpp, vLLM, OpenAI, Groq, OpenRouter)
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=
MERIDIAN_MODEL=qwen2.5:14b
MERIDIAN_FAST_MODEL=llama3.2:3b
MERIDIAN_EMBED_MODEL=nomic-embed-text
OPENAI_MODEL=

# Optional live rank tracking (SerpApi / Serper / SearchApi / ValueSerp / custom)
SERP_PROVIDER_URL=
SERP_PROVIDER_KEY=
SERP_PROVIDER_NAME=

# Set to false in production so demo companies, contacts, and leads are not inserted.
# Docker Compose defaults this to false. `npm run dev` seeds demo data when it is unset.
MERIDIAN_SEED_DEMO=true

# Internet harden — required in production (32+ chars)
MERIDIAN_AUTH_SECRET=
MERIDIAN_SECRET_KEY=

# Collections desk. sandbox is the default and does not call providers.
# A real send also needs MERIDIAN_CHANNEL_DELIVER=live, a provider name below, and that provider's keys.
# Voice audio stays on the sandbox console.
MERIDIAN_CHANNEL_DELIVER=sandbox
MERIDIAN_SMS_PROVIDER=sandbox
MERIDIAN_EMAIL_PROVIDER=sandbox
MERIDIAN_LETTER_PROVIDER=sandbox
MERIDIAN_PAYMENTS_PROVIDER=sandbox
# 12 CFR 1006.100 is three years. Counsel should confirm this clock.
MERIDIAN_PII_RETENTION_DAYS=1095
MERIDIAN_AGENCY_FEE_PERCENT=0
# Job worker tick. Minimum effective value is 15 seconds. Default 60.
MERIDIAN_JOB_INTERVAL_SECONDS=60
# FCC Reassigned Numbers Database. sandbox returns unknown and blocks a cell call.
MERIDIAN_RND_PROVIDER=sandbox
MERIDIAN_RND_API_URL=
MERIDIAN_RND_API_KEY=
# DMDC SCRA. sandbox returns unknown and does not clear anyone. dmdc blocks while unknown.
MERIDIAN_SCRA_PROVIDER=sandbox
MERIDIAN_SCRA_API_URL=
MERIDIAN_SCRA_API_KEY=
MERIDIAN_SCRA_BLOCK_UNKNOWN=
# Metro 2 stays off until this is enabled AND owner and compliance have both approved.
MERIDIAN_METRO2_EXPORT=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TELNYX_API_KEY=
TELNYX_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_WEBHOOK_SECRET=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
LOB_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
VAPI_API_KEY=
RETELL_API_KEY=
OPENAI_REALTIME_MODEL=
LOB_API_KEY=
LOB_MODE=sandbox
MERIDIAN_RND_API_URL=
STRIPE_SECRET_KEY=

# Polar (open-source merchant of record) — $275 lifetime seat
# Create a one-time product at https://polar.sh and paste its product UUID.
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production
