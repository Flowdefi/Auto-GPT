      "long_term_plan_floor_pct": {
        "value": 40,
        "is_default": true
      },
      "required_templates": [
        "LTR-060 or LTR-061 (TX)"
      ],
      "litigation_references_allowed": false
    },
    {
      "tier_id": "HARDSHIP",
      "match": {
        "hardship_reported": true
      },
      "applies_on_top_of_base_tier": true,
      "additional_discount_pct_points": {
        "value": 10,
        "is_default": true
      },
      "absolute_floor_pct": {
        "value": 20,
        "is_default": true
      },
      "min_monthly_payment": {
        "value": 10.0,
        "is_default": true
      },
      "max_long_term_months": {
        "value": 36,
        "is_default": true
      },
      "documentation_required": {
        "value": false,
        "is_default": true,
        "note": "Do not require medical records"
      }
    }
  ],
  "portfolio_overrides": [
    {
      "portfolio_id": "{{portfolio_id}}",
      "seller_or_client": "{{client_name}}",
      "floor_pct_override": {
        "value": null,
        "is_default": true
      },
      "notes": "Set per purchase agreement or client placement contract"
    }
  ],
  "tier_resolution": "First matching tier in list order; HARDSHIP modifies the resolved base tier; portfolio_overrides win over tiers.",
  "needs_counsel_review": true,
  "contact_policy": {
    "max_call_attempts_per_debt_per_7_days": {
      "value": 5,
      "is_default": true,
      "legal_ceiling": 7,
      "source": "12 CFR 1006.14(b)(2)"
    },
    "max_sms_per_debt_per_7_days": {
      "value": 3,
      "is_default": true
    },
    "max_email_per_debt_per_7_days": {
      "value": 3,
      "is_default": true
    },
    "calling_window_local": {
      "value": [
        "08:00",
        "21:00"
      ],
      "is_default": true,
      "source": "12 CFR 1006.6(b)(1)"
    },
    "texas_bond_on_file_required": {
      "value": true,
      "source": "Tex. Fin. Code 392.101"
    }
  }
