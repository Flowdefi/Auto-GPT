        "value": 55,
        "is_default": true
      },
      "step_down_pct": {
        "value": 5,
        "is_default": true
      },
      "floor_pct": {
        "value": 35,
        "is_default": true
      },
      "short_term_plan_floor_pct": {
        "value": 45,
        "is_default": true
      },
      "long_term_plan_floor_pct": {
        "value": 60,
        "is_default": true
      }
    },
    {
      "tier_id": "T5_time_barred",
      "match": {
        "time_barred": true
      },
